# Copy this file to .env and fill your real key. Do not commit .env.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: move command-line flags into .env
PHYSICS_AUTO_REVIEW_PROVIDER=openai
PHYSICS_AUTO_REVIEW_THRESHOLD=0.90
PHYSICS_AUTO_REVIEW_MAX_ITEMS=0
PHYSICS_FAIL_ON_REVIEW_REQUIRED=true
PHYSICS_ALLOW_REVIEW_REQUIRED=false
PHYSICS_PLACEHOLDER_UNREVIEWED=false
PHYSICS_SKIP_FINAL_ARTIFACT_GATE=false
PHYSICS_ALLOW_FINAL_ARTIFACTS=false


GRADE10_MATHS_AUTO_REVIEW_PROVIDER=openai
GRADE10_MATHS_VISION_MODEL=gpt-4o-mini
GRADE10_MATHS_MATH_PRECISION_MODEL=gpt-4o
GRADE10_MATHS_AUTO_REVIEW_THRESHOLD=0.90
GRADE10_MATHS_FAIL_ON_REVIEW_REQUIRED=false
GRADE10_MATHS_VISION_SCALE=2.5

GRADE10_MATHS_FINAL_AUDIT=true
GRADE10_MATHS_FINAL_AUDIT_MODE=fast
GRADE10_MATHS_MATH_PRECISION_AUDIT=true
GRADE10_MATHS_MATH_AUDIT_MODE=standard

GRADE10_MATHS_FULL_IMAGE_VERIFY=false
GRADE10_MATHS_FULL_VERIFY_MODEL=gpt-4o

GRADE10_MATHS_LLM_REPAIR_FAILED_PAGES=true
GRADE10_MATHS_LLM_REPAIR_MAX_ROUNDS=2
